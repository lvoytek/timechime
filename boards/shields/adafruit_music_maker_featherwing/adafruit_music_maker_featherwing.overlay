/ {
	aliases {
		sdhc0 = &sdhc0_adafruit_music_maker_featherwing;
	};
};

/* Waveshare shield declares its own SD slot with disk-name "SD"; disable it to avoid conflict. */
&waveshare_epaper_sdhc {
	status = "disabled";
	mmc {
		status = "disabled";
	};
};

&feather_spi {
	status = "okay";
	cs-gpios = <&feather_header 14 GPIO_ACTIVE_LOW>, /* D5  - SD card  */
		   <&feather_header 15 GPIO_ACTIVE_LOW>;  /* D6  - VS1053 XCS */

	sdhc0_adafruit_music_maker_featherwing: sdhc@0 {
		compatible = "zephyr,sdhc-spi-slot";
		reg = <0>;
		spi-max-frequency = <12000000>;
		status = "okay";

		sdmmc {
			compatible = "zephyr,sdmmc-disk";
			disk-name = "SD";
			status = "okay";
		};
	};

	vs1053: vs1053@1 {
		compatible = "vlsi,vs1053";
		reg = <1>;
		/* SCI (control) clock; SDI uses sdi-max-frequency (default 8 MHz) */
		spi-max-frequency = <250000>;
		dreq-gpios = <&feather_header 16 GPIO_ACTIVE_HIGH>; /* D9  */
		dcs-gpios  = <&feather_header 17 GPIO_ACTIVE_LOW>;  /* D10 */
		status = "okay";
	};
};
