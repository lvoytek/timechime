/*
 * Feather m4 express pin overlay
 * Map Arduino R3 + arduino_spi for screen compatibility.
 * Map additional GPIOs for navigation buttons.
 * Map Uart for GPS using gnss.
 *
 *   Arduino R3 | Feather pin | SAMD21 GPIO | Shield signal
 *   -----------+-------------+-------------+--------------
 *   D4         | A0          | PA02        | Unused SDHC CS
 *   D7         | A1          | PA05        | Busy
 *   D8         | A2          | PB08        | Reset
 *   D9         | A3          | PB09        | DC
 *   D10        | A4          | PA04        | E-paper CS
 *   MOSI       | D24         | PB23        | sercom1 MOSI
 *   SCK        | D25         | PA17        | sercom1 SCK
 */

#include <zephyr/dt-bindings/gpio/arduino-header-r3.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
	aliases {
		gnss = &gnss;
		sw0 = &button0;
		sw1 = &button1;
		sw2 = &button2;
		sw3 = &button3;
	};

	buttons {
		compatible = "gpio-keys";
		button0: button_0 {
			gpios = <&porta 20 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			zephyr,code = <INPUT_KEY_0>;
		};
		button1: button_1 {
			gpios = <&porta 19 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			zephyr,code = <INPUT_KEY_1>;
		};
		button2: button_2 {
			gpios = <&porta 18 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			zephyr,code = <INPUT_KEY_2>;
		};
		button3: button_3 {
			gpios = <&porta 16 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			zephyr,code = <INPUT_KEY_3>;
		};
	};

	arduino_header: connector {
		compatible = "arduino-header-r3";
		#gpio-cells = <2>;
		gpio-map-mask = <0xffffffff 0xffffffc0>;
		gpio-map-pass-thru = <0 0x3f>;
		gpio-map =
			<ARDUINO_HEADER_R3_D4  0 &porta 2 0>,
			<ARDUINO_HEADER_R3_D7  0 &porta 5 0>,
			<ARDUINO_HEADER_R3_D8  0 &portb 8 0>,
			<ARDUINO_HEADER_R3_D9  0 &portb 9 0>,
			<ARDUINO_HEADER_R3_D10 0 &porta 4 0>;
	};
};

&sercom5 {
	current-speed = <9600>;

	gnss: gnss-nmea-generic {
		compatible = "gnss-nmea-generic";
	};
};

arduino_spi: &sercom1 {
	/* Board DTS has dipo/dopo swapped: PB23 is physically MOSI (PAD3),
	 * PB22 is MISO (PAD2). dopo=2 → MOSI=PAD3, SCK=PAD1; dipo=2 → MISO=PAD2 */
	dipo = <2>;
	dopo = <2>;
};
